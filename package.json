{
  "name": "svnn-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:fe": "npm run dev -w apps/frontend",
    "dev:be": "npm run start:dev -w apps/backend",
    "dev:ai": "npm run dev -w apps/ai",
    "dev": "concurrently -n FE,BE,AI -c green,blue,magenta \"npm:dev:fe\" \"npm:dev:be\" \"npm:dev:ai\"",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
